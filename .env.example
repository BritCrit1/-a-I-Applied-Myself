DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=sqlite:///db.sqlite3

LLM_PROVIDER=stub
MANUS_API_BASE_URL=
MANUS_API_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Enable only after Play Console and backend verification are configured.
BILLING_REQUIRED=false
PLAY_PACKAGE_NAME=com.britcrit.aiams
# Local development only: path to an authorized service-account credential file.
# Cloud Run uses its attached service account; do not ship credentials in the APK.
GOOGLE_APPLICATION_CREDENTIALS=
# Production additionally requires DEPLOYMENT_ENV=production, a PostgreSQL
# DATABASE_URL, GS_BUCKET_NAME, and the exact Cloud Run host in DJANGO_ALLOWED_HOSTS.
